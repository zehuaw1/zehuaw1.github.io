              <tr><td>VR2S (no bg video)</td><td>0.449 &plusmn; 0.082</td><td>0.442 &plusmn; 0.109</td><td>0.594 &plusmn; 0.074</td><td><strong>0.544</strong> &plusmn; 0.085</td><td>11.35 &plusmn; 2.08</td></tr>
              <tr><td>VR2S (full)</td><td>0.525 &plusmn; 0.092</td><td>0.509 &plusmn; 0.121</td><td><strong>0.557</strong> &plusmn; 0.053</td><td>0.601 &plusmn; 0.067</td><td><strong>12.12</strong> &plusmn; 2.51</td></tr>
