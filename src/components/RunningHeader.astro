---
let updatedDate = new Date();
try {
  const { execSync } = await import('child_process');
  const gitDate = execSync('git log -1 --format=%ci', { encoding: 'utf-8' }).trim();
  if (gitDate) updatedDate = new Date(gitDate);
} catch {}

const month = updatedDate.toLocaleString('en-US', { month: 'short', timeZone: 'America/New_York' }).toUpperCase();
const year = updatedDate.toLocaleString('en-US', { year: 'numeric', timeZone: 'America/New_York' });
---

<aside class="running-header" aria-label="Page metadata">
  <span>ZEHUA WANG</span>
  <span class="rh-sep" aria-hidden="true">·</span>
  <span>PHYSICS / AI</span>
  <span class="rh-sep" aria-hidden="true">·</span>
  <span>MIT '28</span>
  <span class="rh-sep" aria-hidden="true">·</span>
  <span>{month} {year}</span>
</aside>

<style>
  .running-header {
    display: none;
    max-width: 72rem;
    margin: 0 auto;
    padding: 0.6rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border-subtle);
    align-items: center;
    gap: 0.6rem;
  }

  @media (min-width: 768px) {
    .running-header {
      display: flex;
    }
  }

  .rh-sep {
    color: var(--border);
    font-weight: 400;
  }
</style>
