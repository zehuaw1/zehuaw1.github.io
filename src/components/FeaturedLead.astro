---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;

const iconMap: Record<string, string> = {
  paper: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  code: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  demo: 'M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z',
  video: 'M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  website: 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9',
};

const description = project.longDescription ?? project.description;
---

<article class="lead">
  <div class="lead-meta">
    <span class="lead-year">{project.year}</span>
    {project.venue && <em class="lead-venue">{project.venue}</em>}
    <span class="lead-marker">Lead</span>
  </div>

  <a href={`/projects/${project.slug}`} class="lead-title-link">
    <h3 class="lead-title">{project.title}</h3>
  </a>

  <p class="lead-description">{description}</p>

  <div class="lead-footer">
    <div class="lead-tags">
      {project.tags.slice(0, 5).map((tag) => (
        <span class="lead-tag">{tag}</span>
      ))}
    </div>

    <div class="lead-links">
      {project.links.map((link) => (
        <a
          href={link.url}
          class="lead-link"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={iconMap[link.type] ?? iconMap.website} />
          </svg>
          {link.label ?? link.type}
        </a>
      ))}
      <a href={`/projects/${project.slug}`} class="lead-link lead-link-primary">
        Details
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14m-7-7 7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</article>

<style>
  .lead {
    grid-column: 1 / -1;
    padding: 1.75rem 0 2rem;
    border-bottom: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .lead-meta {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .lead-year {
    font-size: 0.78rem;
    font-weight: 500;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .lead-venue {
    font-size: 0.85rem;
    font-style: italic;
    color: var(--text-secondary);
  }

  .lead-marker {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-left: auto;
  }

  .lead-title-link {
    text-decoration: none;
  }

  .lead-title {
    font-size: clamp(1.4rem, 3vw, 1.85rem);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0;
    transition: color 0.15s ease;
  }

  .lead-title-link:hover .lead-title {
    color: var(--accent);
  }

  .lead-description {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin: 0;
    max-width: 60ch;
  }

  .lead-footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }

  .lead-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .lead-tag {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--text-muted);
  }

  .lead-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .lead-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .lead-link:hover {
    color: var(--text-primary);
  }

  .lead-link-primary {
    color: var(--accent);
  }

  .lead-link-primary:hover {
    color: var(--accent-hover);
  }
</style>
